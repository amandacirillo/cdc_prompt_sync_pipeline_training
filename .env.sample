# Sample environment variables for local development.
# Copy to .env and fill in real values for local testing; never commit .env.

LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000

# Database and local service configuration
DYNAMODB_TABLE=support-guideline-tracking-table
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
SQS_QUEUE_URL=http://sqs:9324/queue/support-processing-queue
SQS_ENDPOINT=http://sqs:9324
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=testdb
MARIADB_USER=root
MARIADB_PASSWORD=password

# CDK settings: RDS source endpoint for the DMS replication task
CDK_RDS_TYPE=mariadb
CDK_RDS_SERVER=
CDK_RDS_PORT=
CDK_RDS_DATABASENAME=
CDK_RDS_USERNAME=
CDK_RDS_PASSWORD=
